# Copy to .env.local. Never prefix a secret with NEXT_PUBLIC_.
# Leave both empty to keep using the existing browser data until setup is complete.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Self-hosted PostgreSQL takes precedence when configured. Keep credentials server-only.
DATABASE_URL=
# Cloudflare R2 Standard; public media must use a dedicated HTTPS origin.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
MEDIA_PUBLIC_URL=

# A stable random value, at least 32 characters, shared across server instances.
ADMIN_SESSION_SECRET=
# Required: 16–256 characters with a letter, digit and non-space symbol.
# Missing/weak password disables login. There is no default password.
ADMIN_PASSWORD=

# Development only: explicitly allow local in-memory admin sessions when Supabase
# is absent. Ignored in production. Restarting the server revokes these sessions.
ADMIN_LOCAL_AUTH=false

# Optional comma-separated exact public origins (scheme + host + optional port).
# Use behind a reverse proxy if the upstream Host differs from the public origin.
ADMIN_ALLOWED_ORIGINS=

# Optional IP header set/overwritten by YOUR trusted reverse proxy.
# Leave empty unless the backend cannot be reached while bypassing that proxy.
# Empty = one shared source bucket (5 login attempts / 15 minutes).
ADMIN_TRUSTED_IP_HEADER=
