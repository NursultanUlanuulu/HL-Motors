# Copy to .env.local. Never prefix a secret with NEXT_PUBLIC_.
# Leave both empty to keep using the existing browser data until setup is complete.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# A stable random value, at least 32 characters, shared across server instances.
ADMIN_SESSION_SECRET=
# Optional. Without this variable the existing password remains in use.
ADMIN_PASSWORD=
